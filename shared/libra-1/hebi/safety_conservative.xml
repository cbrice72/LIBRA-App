<?xml version="1.0"?>
<group_safety version="1.0.0">
  <!-- Actuators: "MA", "MB", "J1", "J2", "J3" -->
  <mstop />
  <position>
    <!-- 3.142 rad ~= 180 deg -->
    <!-- NOTE: The MA-MB relationship is a bit more complicated, so just give them "infinite" limits -->
    <min_limit>-1000 -1000 -3.142 -3.142 -3.142</min_limit>
    <max_limit>1000 1000 3.142 3.142 3.142</max_limit>
  </position>
  <velocity>
    <!-- 0.052 rad/s ~= 3 deg/s -->
    <!-- 0.018 rad/s ~= 1 deg/s -->
    <min_limit>-0.052 -0.052 -0.052 -0.052 -0.018</min_limit>
    <max_limit>0.052 0.052 0.052 0.052 0.018</max_limit>
  </velocity>
  <effort>
    <!-- For X8-16: Cont. Torque = 16 Nm, Peak Torque = 38 Nm -->
    <!-- NOTE: Give J1 higher limits since it bears the brunt of the arm torque -->
    <min_limit>-20 -20 -38 -20 -20</min_limit>
    <max_limit>20 20 38 20 20</max_limit>
  </effort>
</group_safety>

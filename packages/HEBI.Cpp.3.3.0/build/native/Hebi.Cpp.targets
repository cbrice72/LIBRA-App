<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>$(MSBuildThisFileDirectory)Hebi\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
    	<AdditionalLibraryDirectories>$(MSBuildThisFileDirectory)..\..\lib\$(PlatformTarget);%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
    	<AdditionalDependencies>hebi.lib</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
  <!-- Use this to copy hebi.dll to output directory -->
  <ItemGroup>
    <NativeLibs Include="$(MSBuildThisFileDirectory)..\..\lib\$(PlatformTarget)\*.dll" />
    <None Include="@(NativeLibs)">
      <Link>%(RecursiveDir)%(FileName)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <ItemGroup>
    <ClCompile Include="$(MSBuildThisFileDirectory)Hebi\src\*.cpp" />
    <ClCompile Include="$(MSBuildThisFileDirectory)Hebi\src\arm\*.cpp" />
    <ClCompile Include="$(MSBuildThisFileDirectory)Hebi\src\util\*.cpp" />
  </ItemGroup>
</Project>
